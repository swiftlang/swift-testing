{
  "schemaVersion": "1.0",
  "swiftCompiler": {
    "extraCLIOptions": [
      "-enable-experimental-feature", "Embedded",
      "-wmo"
    ]
  },
  "linker": {
    "extraCLIOptions": [
      "-lm",
      "-lstdc++",
      "-L/swift/usr/lib/swift/embedded/x86_64-unknown-linux-gnu/",
      "/swift/usr/lib/swift/embedded/x86_64-unknown-linux-gnu/libswift_Concurrency.a",
      "/swift/usr/lib/swift/embedded/x86_64-unknown-linux-gnu/libswift_ConcurrencyDefaultExecutor.a",
      "-lswiftUnicodeDataTables",
      "-lswiftEmbeddedPlatformPOSIX",
      "-lswiftEmbeddedPlatformMultiThreadedPOSIX"
    ]
  }
}
