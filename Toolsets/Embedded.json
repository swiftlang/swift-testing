{
  "schemaVersion": "1.0",
  "swiftCompiler": {
    "extraCLIOptions": [
      "-enable-experimental-feature", "Embedded",
      "-wmo",
      "-Xfrontend", "-disable-stack-protector",
    ]
  },
  "linker": {
    "extraCLIOptions": [
      "-lswiftUnicodeDataTables",
      "-lswiftEmbeddedPlatformPOSIX",
      "-lswiftEmbeddedPlatformMultiThreadedPOSIX"
    ]
  }
}
