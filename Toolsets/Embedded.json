{
  "schemaVersion": "1.0",
  "swiftCompiler": {
    "extraCLIOptions": [
      "-enable-experimental-feature", "Embedded",
      "-wmo"
    ]
  },
  "linker": {
    "extraCLIOptions": [
      "-lm",
      "-L/swift/usr/lib/swift/embedded/x86_64-unknown-linux-gnu/",
      "/swift/usr/lib/swift/linux/libswift_Concurrency.so",
      "-lswiftUnicodeDataTables",
      "-lswiftEmbeddedPlatformPOSIX",
      "-lswiftEmbeddedPlatformMultiThreadedPOSIX"
    ]
  }
}
